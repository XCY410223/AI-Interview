# =============================================================================
# 开发镜像：安装全部依赖（含 requirements-dev.txt），uvicorn --reload 热重载
# 规范 §15：开发用 docker-compose.dev.yml（挂载源码热重载）
#
#   注意：ragas 等开发期依赖仅进开发镜像，禁止进生产镜像（规范 §5/§9.7）
# =============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH" \
    TZ=Asia/Shanghai

# 国内 Debian 镜像（可用 --build-arg APT_MIRROR=deb.debian.org 覆盖）
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 系统依赖：curl(healthcheck) procps(pgrep) tzdata(时区) ca-certificates(HTTPS)
# WeasyPrint(M3 PDF)：Pango 系库 + CJK 字体（与 Dockerfile 保持一致）
RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl procps tzdata \
        libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 libffi-dev shared-mime-info \
        fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app app \
    && mkdir -p /home/app/celerybeat \
    && chown -R app:app /home/app

WORKDIR /app

# 国内 PyPI 镜像（可用 --build-arg PIP_INDEX_URL=https://pypi.org/simple 覆盖）
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 依赖分层缓存（含 dev 依赖：pytest/mypy/ragas 等）
COPY requirements.txt requirements-dev.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip -i ${PIP_INDEX_URL} \
    && /opt/venv/bin/pip install -r requirements-dev.txt -i ${PIP_INDEX_URL}

COPY --chown=app:app . .

USER app

EXPOSE 8006

# 源码由 dev overlay 挂载 ./:/app，--reload 监听变更热重载
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8006", "--reload"]
