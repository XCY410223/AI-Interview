# =============================================================================
# 部署环境变量模板（VM 演示版，§收尾计划书 B3）
#
# 用法（在 VM 的 backend/ 目录下）：
#   cp .env.deploy.example .env && vi .env
#   # 只填「【必填】」项即可；其余保留默认值。
#
# 说明：
#   - 本文件值留空的都是密钥类，必须换成强值（禁止用 minioadmin / postgres 默认）。
#   - 连接类（POSTGRES_HOST/PORT、REDIS_HOST/PORT、S3_ENDPOINT、CELERY_*）会被
#     docker-compose 的 x-app-env 覆盖为容器内主机名（postgres/redis/minio），此处无需改。
#   - SMTP_* 不用填：演示用 dev 覆盖层的 Mailpit（已注入 SMTP_HOST=mailpit:1025，Web UI 8025）。
#   - 生成 SECRET_KEY：python -c "import secrets;print(secrets.token_urlsafe(48))"
# =============================================================================

# ===== 应用 =====
APP_NAME=ai-interview
APP_ENV=production                       # 演示也可 development（dev 覆盖层会强制覆盖为 development）
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=                              # 【必填】随机生成（token_urlsafe(48)），禁止默认值
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 数据库（PostgreSQL 16 + pgvector）=====
POSTGRES_HOST=postgres                   # 容器内服务名，compose 已覆盖
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                       # 【必填】强口令，别用 postgres
POSTGRES_DB=ai_interview

# ===== Redis 7 =====
REDIS_HOST=redis                         # 容器内服务名，compose 已覆盖
REDIS_PORT=6379
REDIS_DB=0

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== 对象存储（MinIO，S3 协议）=====
S3_ENDPOINT=http://minio:9000            # 容器内服务名，compose 已覆盖
S3_ACCESS_KEY=                           # 【必填】强口令，别用 minioadmin
S3_SECRET_KEY=                           # 【必填】强口令，别用 minioadmin
S3_BUCKET=ai-interview
S3_REGION=us-east-1

# ===== LLM 统一客户端（AsyncOpenAI 兼容，多 provider）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=                             # 【必填】你的 DeepSeek Key（面试/报告功能依赖）
LLM_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-reasoner
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_TOTAL_TIMEOUT=120
LLM_MAX_RETRIES=3

# ===== Embedding（bge-m3，评估与生产必须同源）=====
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=                      # 【必填】空着 RAG 入库/检索会快速失败
EMBEDDING_API_KEY=                       # 【必填】同上
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== 邮件（演示用 Mailpit，此处留空）=====
SMTP_HOST=                               # 不用填：dev 覆盖层注入 mailpit:1025
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI-Interview <noreply@example.com>
SMTP_USE_TLS=false

# ===== 密码找回 =====
FRONTEND_BASE_URL=http://<VM_IP>/        # 【必填】改成 http://<VM的IP>/，否则找回密码邮件链接是死链
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_IP_LIMIT_PER_HOUR=10
PASSWORD_RESET_EMAIL_LIMIT_PER_HOUR=3

# ===== AI 限流 =====
AI_RATE_LIMIT_PER_HOUR=20
MAX_QUESTIONS_PER_INTERVIEW=15
