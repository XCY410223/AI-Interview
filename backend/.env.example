# ===== 应用 =====
APP_NAME=ai-interview
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production          # 生产强制随机生成，禁止默认值
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 数据库（PostgreSQL 16 + pgvector）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview

# ===== Redis 7 =====
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_DB=0

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6382/1
CELERY_RESULT_BACKEND=redis://localhost:6382/2

# ===== 对象存储（dev: MinIO / prod: COS，S3 协议）=====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-interview
S3_REGION=us-east-1

# ===== LLM 统一客户端（AsyncOpenAI 兼容，多 provider）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-reasoner
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_TOTAL_TIMEOUT=120
LLM_MAX_RETRIES=3

# ===== Embedding（bge-m3，评估与生产必须同源）=====
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== 邮件（SMTP + Brevo）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== AI 限流 =====
AI_RATE_LIMIT_PER_HOUR=20
MAX_QUESTIONS_PER_INTERVIEW=15
